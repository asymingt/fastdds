load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

cc_library(
    name = "fastdds",
    srcs = glob(
        [
            "src/cpp/**/*.h",
            "src/cpp/**/*.hpp",
            "src/cpp/**/*.ipp",
            "src/cpp/**/*.cpp",
            "src/cpp/**/*.cxx",
        ],
        exclude = [
            # Security sources are conditional on HAVE_SECURITY in CMake.
            "src/cpp/rtps/security/**/*.cpp",
            "src/cpp/security/**/*.cpp",
            "src/cpp/rtps/builtin/discovery/participant/DS/PDPSecurityInitiatorListener.cpp",
            # Statistics sources are conditional on FASTDDS_STATISTICS in CMake.
            "src/cpp/statistics/rtps/**/*.cpp",
            "src/cpp/statistics/fastdds/domain/DomainParticipantImpl.cpp",
            "src/cpp/statistics/fastdds/domain/DomainParticipantStatisticsListener.cpp",
            "src/cpp/statistics/types/**/*.cpp",
            "src/cpp/statistics/types/**/*.cxx",
        ],
    ),
    hdrs = glob([
        "include/**/*.hpp",
        "thirdparty/boost/include/**/*.h",
        "thirdparty/boost/include/**/*.hpp",
        "thirdparty/boost/include/**/*.ipp",
        "thirdparty/taocpp-pegtl/**/*.hpp",
    ]) + [
        "thirdparty/filewatch/FileWatch.hpp",
    ],
    # Workaround for GCC 15 / binutils 2.45 bug where .sframe relocations
    # reference symbols in discarded COMDAT sections, causing linker errors.
    cxxopts = [
        "-Wno-deprecated-declarations",
        "-Wno-unknown-pragmas",
        "-Wno-unused-variable",
        "-Wno-sign-compare",
    ],
    includes = [
        "include",
        "src/cpp",
        "src/cpp/utils",
        "thirdparty/boost/include",
        "thirdparty/filewatch",
        "thirdparty/taocpp-pegtl",
        "thirdparty/taocpp-pegtl/pegtl",
        "thirdparty/taocpp-pegtl/pegtl/contrib",
        "thirdparty/taocpp-pegtl/pegtl/internal",
    ],
    local_defines = [
        "SQLITE3_SUPPORT=1",
        "TLS_FOUND=1",
    ],
    deps = [
        "@asio",
        "@fastcdr",
        "@foonathan_memory",
        "@nlohmann_json//:singleheader-json",
        "@openssl",
        "@sqlite3",
        "@tinyxml2",
    ],
)
